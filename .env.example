# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# The defaults below are the emulator setup: they work with no GCP account.
#   npm run emulators   (terminal 1)
#   npm run dev         (terminal 2)
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle — no secrets here) -------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_EMULATORS=true

# Whether to offer the Google button. The Auth emulator fakes the popup, so this
# stays on locally. A fresh cloud project has no OAuth client yet, so the deploy
# sets it false and the app offers the email link alone rather than a button that
# fails on the first click. See docs/DEPLOYMENT.md.
NEXT_PUBLIC_GOOGLE_SIGN_IN=true

# Under emulators these can be any non-empty placeholder; the emulator does not
# verify them. For a real project, copy them from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=marquee-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=marquee-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=marquee-dev.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_EMULATOR_AUTH_PORT=9099
NEXT_PUBLIC_EMULATOR_FIRESTORE_PORT=8080
NEXT_PUBLIC_EMULATOR_STORAGE_PORT=9199

# --- Server-only ------------------------------------------------------------
# NODE_ENV is set by Next itself (development for `next dev`, production for `next build`).
# Do not pin it here — doing so mixes development React into a production build.

# emulator | gcs
STORAGE_DRIVER=emulator
# Required only when STORAGE_DRIVER=gcs
# GCS_BUCKET=marquee-media-prod

# Mixed into join-code hashes. Generate with: openssl rand -hex 32
# Rotating this invalidates every outstanding join code.
JOIN_CODE_PEPPER=change-me-to-a-long-random-string

# Shared secret for POST /api/internal/cleanup. Generate the same way.
CLEANUP_TASK_SECRET=change-me-to-another-long-random-string

# Comma-separated. These accounts are promoted to OWNER on sign-in.
OWNER_EMAILS=you@example.com

# Credentials. Under emulators, leave both unset.
# Locally against a real project: path to a service-account key file.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# On Cloud Run, leave unset — Application Default Credentials are used.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Email ------------------------------------------------------------------
# outbox | resend
# `outbox` writes messages to a Firestore collection instead of sending them, so the
# invite flow works with no provider account. Read them in the emulator UI at :4000.
EMAIL_DRIVER=outbox
# RESEND_API_KEY=re_...

# --- Payments ---------------------------------------------------------------
# mock | stripe
# `mock` runs a local checkout page that completes a real plan change through the real
# webhook. It refuses to run when NODE_ENV=production.
BILLING_DRIVER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_EVENT=price_...
# STRIPE_PRICE_PRO=price_...

# --- Feature flag overrides (optional) --------------------------------------
# Turning this on activates the plan gates and the real checkout.
# FEATURE_BILLING=false
# FEATURE_ADMIN_CONSOLE=false
# FEATURE_SAFETY_SCAN=false
# FEATURE_ADS=false
